# Server-only content generation. Never copy these values into apps/mobile/.env.
OPENAI_API_KEY=
OPENAI_PRODUCER_MODEL=gpt-5.4-mini
OPENAI_REVIEWER_MODEL=gpt-5.4-mini
SUPABASE_SERVICE_ROLE_KEY=

# Gemini remains disabled until a paid API data-usage tier is verified.
GEMINI_API_KEY=
GEMINI_PRODUCER_MODEL=
GEMINI_API_TIER=free

# Server-only SMTP credentials for local Supabase Auth. Use an SMTP key, not a Brevo API key.
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SENDER_EMAIL=
