              "eventState": {
                "type": "string",
                "minLength": 1
              },
              "emotion": {
                "type": "string",
                "enum": ["happy", "sad", "angry", "scared", "neutral"]
              },
              "allowedNarrativeTerms": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prohibitedNarrativeTerms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reviewStatus": {
                "type": "string",
                "enum": ["pending", "approved"]
              },
              "rightsStatus": {
                "type": "string",
                "enum": ["needs_confirmation", "cleared"]
              },
              "provenance": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": ["gemini-apps", "owned", "licensed"]
                  },
                  "aiGenerated": {
                    "type": "boolean"
                  },
                  "generatedByUser": {
                    "type": "boolean"
                  },
                  "thirdPartyReferencesDeclared": {
                    "type": "boolean"
                  },
                  "disclosure": {
                    "type": "string",
                    "minLength": 1
                  }
