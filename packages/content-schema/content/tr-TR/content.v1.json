        {
          "id": "notice-goodbye-emotion",
          "type": "emotion_choice",
          "prompt": "Arkadaşı giderken Mino nasıl hissediyor olabilir?",
          "choices": [
            {
              "id": "goodbye-sad",
              "emotion": "sad",
