  "stories": [
    {
      "id": "mino-balloon-story",
      "version": 1,
      "title": "Mino'nun Balonu",
      "ageBands": ["2-4"],
      "targetSkills": ["emotion_recognition", "helping", "co_regulation"],
      "greetingTemplate": "Merhaba {{childName}}! Ben Mino. Benimle balon oynar mısın?",
      "sceneAssetId": "scene-birthday-balloons",
      "characterAssets": {
        "happyAssetId": "character-mino-happy",
        "sadAssetId": "character-mino-sad"
      },
      "steps": [
        {
          "id": "choose-balloon",
          "type": "choice",
          "prompt": "Mino'ya bir balon seçelim. Hangisini istersin?",
          "choices": [
            {
              "id": "coral-balloon",
              "accessibilityLabel": "Mercan kırmızısı balon",
              "visual": { "kind": "balloon", "color": "#F46F5E" },
              "acknowledgement": "Bu balonu seçtin. Haydi birlikte şişirelim!"
            },
            {
              "id": "blue-balloon",
              "accessibilityLabel": "Mavi balon",
              "visual": { "kind": "balloon", "color": "#55A9D6" },
              "acknowledgement": "Bu balonu seçtin. Haydi birlikte şişirelim!"
            }
          ]
        },
        {
          "id": "inflate-balloon",
          "type": "tap",
          "prompt": "Balonu şişirmek için ekrana iki kez dokun.",
          "requiredTaps": 2,
          "completionNarration": "Balon büyüdü!"
        },
        {
          "id": "balloon-pops",
          "type": "event",
          "narration": "Pat! Mino'nun balonu patladı. Mino'ya bakalım."
        },
        {
          "id": "notice-emotion",
          "type": "emotion_choice",
          "prompt": "Sence Mino nasıl hissediyor olabilir?",
          "choices": [
            {
              "id": "sad",
              "emotion": "sad",
              "accessibilityLabel": "Üzgün yüz",
              "supportiveFeedback": {
                "narration": "Üzgün olabileceğini düşündün."
              }
            },
            {
              "id": "scared",
              "emotion": "scared",
              "accessibilityLabel": "Korkmuş yüz",
              "supportiveFeedback": {
                "narration": "Patlama sesinden korkmuş olabileceğini düşündün."
              }
            }
          ],
          "storyResolution": {
            "narration": "Bu hikâyede Mino, balonu patladığı için üzgün hissediyor."
          }
        },
        {
          "id": "help-mino",
          "type": "help_choice",
          "prompt": "Mino'ya sarılabilir, yeni bir balon verebilir ya da onunla nefes alabilirsin. Hangisini istersin?",
          "choices": [
            {
              "id": "hug-mino",
              "action": "hug",
              "accessibilityLabel": "Mino'ya sarıl",
              "resultNarration": "Mino'ya sıcacık sarıldın. Yanında olduğunu hissetti."
            },
            {
              "id": "give-balloon",
              "action": "new_balloon",
              "accessibilityLabel": "Mino'ya yeni balon ver",
              "resultNarration": "Mino'ya yeni bir balon verdin. Mino teşekkür ediyor."
            },
            {
              "id": "breathe-together",
              "action": "breathe",
              "accessibilityLabel": "Mino ile nefes al",
              "resultNarration": "Mino'yla birlikte yavaşça nefes almaya başladın."
            }
          ]
        },
        {
          "id": "calm-together",
          "type": "breathing",
          "narration": "Şimdi Mino'yla bir kez yavaşça nefes alalım. İçeri... ve dışarı...",
          "cycles": 1
        },
        {
          "id": "story-finished",
          "type": "closing",
          "narration": "Mino şimdi kendini biraz daha iyi hissediyor. Ona yardım ettiğin için teşekkür ederim!"
        }
      ]
    },
    {
      "id": "mino-block-tower-story",
      "version": 1,
      "title": "Mino'nun Kulesi",
      "ageBands": ["2-4"],
      "targetSkills": ["emotion_recognition", "coping", "helping"],
      "greetingTemplate": "Merhaba {{childName}}! Mino bloklarla yüksek bir kule yapıyor. Birlikte bakalım mı?",
      "sceneAssetId": "scene-block-tower",
      "characterAssets": {
        "happyAssetId": "character-mino-happy",
        "sadAssetId": "character-mino-sad"
      },
      "steps": [
        {
          "id": "tower-falls",
          "type": "event",
          "narration": "Mino son bloğu koyarken kule devrildi. Bloklar yere dağıldı."
        },
        {
          "id": "notice-tower-emotion",
          "type": "emotion_choice",
          "prompt": "Kulesi yıkılan Mino nasıl hissediyor olabilir?",
          "choices": [
            {
              "id": "tower-sad",
              "emotion": "sad",
              "accessibilityLabel": "Üzgün yüz",
              "supportiveFeedback": {
                "narration": "Emek verdiği kule yıkılınca üzülmüş olabileceğini düşündün."
              }
            },
            {
              "id": "tower-angry",
              "emotion": "angry",
              "accessibilityLabel": "Kızgın yüz",
              "supportiveFeedback": {
                "narration": "Kulesi birden yıkılınca kızmış olabileceğini düşündün."
              }
            }
          ],
          "storyResolution": {
            "narration": "Bazen bir şey yıkıldığında üzgün ya da kızgın hissedebiliriz. İki duygu da anlaşılabilir."
          }
        },
        {
          "id": "help-rebuild",
          "type": "help_choice",
          "prompt": "Mino'ya nasıl eşlik etmek istersin?",
          "choices": [
            {
              "id": "hug-after-tower",
              "action": "hug",
              "accessibilityLabel": "Mino'ya sarıl",
              "resultNarration": "Mino'ya sarıldın. Mino yanında olduğunu hissetti."
            },
            {
              "id": "breathe-after-tower",
              "action": "breathe",
              "accessibilityLabel": "Mino ile nefes al",
              "resultNarration": "Mino'yla yavaşça nefes aldın. Yeniden denemeye hazır hissediyor."
            }
          ]
        },
        {
          "id": "tower-finished",
          "type": "closing",
          "narration": "Mino blokları topladı. Hazır olduğunda kulesini yeniden deneyebilir."
        }
      ]
    },
    {
