{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": { "includes": ["**", "!!**/.next", "!!**/.expo", "!!**/dist-ci", "!!**/node_modules"] },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
