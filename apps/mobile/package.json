{
  "name": "@adaptive/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --go --tunnel",
    "build:development:ios": "eas build --platform ios --profile development",
    "build:ios": "expo export --platform ios --output-dir dist-ci",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adaptive/activity-engine": "workspace:*",
    "@adaptive/analytics-events": "workspace:*",
    "@adaptive/content-schema": "workspace:*",
    "@adaptive/evidence-engine": "workspace:*",
    "@adaptive/parent-insights": "workspace:*",
    "@adaptive/personalization-engine": "workspace:*",
    "@adaptive/shared-types": "workspace:*",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~54.0.37",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3",
    "vitest": "latest"
  }
}
